{
  "expo": {
    "name": "Quest Overworld",
    "slug": "quest-overworld",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "questoverworld",
    "newArchEnabled": false,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#1E1A33"
    },
    "android": {
      "usesCleartextTraffic": true,
      "permissions": [
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS"
      ],
      "package": "com.rishab1125.questoverworld"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow Quest Overworld to access your contacts to invite teammates to your party."
        }
      ]
    ]
  }
}
